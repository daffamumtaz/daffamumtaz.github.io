                </div>
                <div class="metric-row">
                  {project.metrics.map((metric) => <span>{metric}</span>)}
                </div>
                <div class="project-stack">
                  {project.stack.map((item) => <span>{item}</span>)}
                </div>
                <div class="project-links">
                  {
                    project.links.map((link) => {
                      const Icon = link.icon;
                      return (
                        <a href={link.href} target="_blank" rel="noreferrer" aria-label={`${project.name} ${link.labelEn}`}>
                          <Icon size={18} />
                          <span data-en={link.labelEn} data-id={link.labelId}>{link.labelEn}</span>
                        </a>
                      );
                    })
                  }
                </div>
              </article>
            ))
