              <p class="panel-label" data-en="Education" data-id="Pendidikan">Education</p>
              <h3>Bachelor of Computer Science</h3>
              <p>IPB University - 2023 to 2027 expected</p>
              <div class="panel-divider"></div>
              <p class="panel-label" data-en="Focused training" data-id="Pelatihan utama">Focused training</p>
              <h3>ASAH 2025 Machine Learning Cohort</h3>
              <p
                data-en="Dicoding Indonesia - 450 learning hours - final score 88.28"
                data-id="Dicoding Indonesia - 450 jam belajar - nilai akhir 88.28"
              >
                Dicoding Indonesia - 450 learning hours - final score 88.28
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-projects" id="projects">
        <div class="section-heading section-heading-row">
          <div>
            <p class="eyebrow" data-en="Project systems" data-id="Sistem proyek">Project systems</p>
            <h2
              data-en="A technical archive of practical systems and measured outputs."
              data-id="Arsip teknis berisi sistem praktis dan output yang terukur."
