              data-id="Proyek software, data, ML, MLOps, dan UX yang disusun berdasarkan tipe sistem, konteks, scope, dan bukti teknis."
            >
              Software, data, ML, MLOps, and UX projects organized by system type, context, scope, and evidence.
            </p>
          </div>
          <a class="text-link" href="https://github.com/daffamumtaz?tab=repositories" target="_blank" rel="noreferrer">
            <span data-en="All repositories" data-id="Semua repositori">All repositories</span>
            <ArrowUpRight size={18} />
          </a>
        </div>

        <div class="project-filters" role="group" aria-label="Filter projects">
          {
            filters.map((filter) => (
              <button
                class="filter-button"
                class:list={{ "is-active": filter.key === "all" }}
                type="button"
                data-filter={filter.key}
                data-en={filter.labelEn}
                data-id={filter.labelId}
              >
                {filter.labelEn}
              </button>
            ))
          }
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <article class="project-card" data-project data-tags={project.tags.join(" ")}>
                <div class="project-topline">
                  <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="project-context" data-en={project.contextEn} data-id={project.contextId}>
                    {project.contextEn}
                  </span>
                </div>
                <h3>{project.name}</h3>
                <p class="project-category" data-en={project.categoryEn} data-id={project.categoryId}>
                  {project.categoryEn}
                </p>
                <p class="project-description" data-en={project.descriptionEn} data-id={project.descriptionId}>
                  {project.descriptionEn}
                </p>
                <div class="project-meta-grid">
                  <div>
                    <span data-en="Role" data-id="Peran">Role</span>
                    <strong data-en={project.roleEn} data-id={project.roleId}>{project.roleEn}</strong>
                  </div>
                  <div>
                    <span data-en="Period" data-id="Periode">Period</span>
                    <strong>{project.period}</strong>
                  </div>
                </div>
