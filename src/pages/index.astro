    <script>
      const languageButtons = document.querySelectorAll<HTMLButtonElement>("[data-language]");
      const translatableElements = document.querySelectorAll<HTMLElement>("[data-en][data-id]");
      const roleText = document.querySelector<HTMLElement>("[data-role-text]");
      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");
      const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter-group]");
      const projectCards = Array.from(document.querySelectorAll<HTMLElement>("[data-project]"));
      const projectGrid = document.querySelector<HTMLElement>("[data-project-grid]");
      const projectArchive = document.querySelector<HTMLElement>("[data-project-archive]");
      const projectCount = document.querySelector<HTMLElement>("[data-project-count]");
      const sortSelect = document.querySelector<HTMLSelectElement>("[data-project-sort]");
      const viewButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-view]");
      type PortfolioLanguage = "en" | "id";
      type PortfolioTheme = "light" | "dark";
      const roleSets: Record<PortfolioLanguage, string[]> = {
        en: ["Software Developer", "Data Scientist", "AI/ML Engineer", "MLOps Learner", "Product-minded Builder"],
        id: ["Software Developer", "Data Scientist", "AI/ML Engineer", "Pembelajar MLOps", "Product-minded Builder"],
      };

      let currentLanguage: PortfolioLanguage = localStorage.getItem("portfolio-language") === "id" ? "id" : "en";
      let currentTheme: PortfolioTheme =
        localStorage.getItem("portfolio-theme") === "dark" ||
        (!localStorage.getItem("portfolio-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches)
          ? "dark"
          : "light";
      let roleIndex = 0;
      let fieldFilter = "all";
      let contextFilter = "all";

      function updateProjectCount() {
        if (!projectCount) return;
        const count = projectCards.filter((card) => !card.hidden).length;
        projectCount.textContent = currentLanguage === "id" ? count + " proyek ditampilkan" : count + " projects shown";
      }

      function applyLanguage(language: PortfolioLanguage) {
        currentLanguage = language;
        document.documentElement.lang = language;
        localStorage.setItem("portfolio-language", language);
        translatableElements.forEach((element) => {
          element.textContent = element.getAttribute("data-" + language) ?? "";
        });
        languageButtons.forEach((button) => {
          button.classList.toggle("is-active", button.getAttribute("data-language") === language);
        });
        roleIndex = 0;
        if (roleText) roleText.textContent = roleSets[language][roleIndex];
        updateProjectCount();
      }

      function applyTheme(theme: PortfolioTheme) {
        currentTheme = theme;
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("portfolio-theme", theme);
        if (themeToggle) {
          themeToggle.setAttribute(
            "aria-label",
            theme === "dark" ? "Switch to light mode" : "Switch to dark mode",
          );
        }
        themeColor?.setAttribute("content", theme === "dark" ? "#191919" : "#f7f7f5");
      }

      languageButtons.forEach((button) => {
        button.addEventListener("click", () =>
          applyLanguage(button.getAttribute("data-language") === "id" ? "id" : "en"),
        );
      });
      themeToggle?.addEventListener("click", () => applyTheme(currentTheme === "dark" ? "light" : "dark"));
      applyTheme(currentTheme);
      applyLanguage(currentLanguage);

      window.setInterval(() => {
        if (!roleText) return;
        roleText.classList.add("is-switching");
        window.setTimeout(() => {
          roleIndex = (roleIndex + 1) % roleSets[currentLanguage].length;
          roleText.textContent = roleSets[currentLanguage][roleIndex];
          roleText.classList.remove("is-switching");
        }, 220);
      }, 3600);

      function renderProjects() {
        const sortMode = sortSelect?.value ?? "newest";
        projectCards.forEach((card) => {
          const domains = (card.getAttribute("data-domain") ?? "").split(" ");
          const context = card.getAttribute("data-context");
          const matchesField = fieldFilter === "all" || domains.includes(fieldFilter);
          const matchesContext = contextFilter === "all" || context === contextFilter;
          card.hidden = !(matchesField && matchesContext);
        });
        const sortedCards = [...projectCards].sort((first, second) => {
          if (sortMode === "az") return (first.getAttribute("data-name") ?? "").localeCompare(second.getAttribute("data-name") ?? "");
          const difference = Number(first.getAttribute("data-sort")) - Number(second.getAttribute("data-sort"));
          return sortMode === "oldest" ? difference : -difference;
        });
        sortedCards.forEach((card) => projectGrid?.appendChild(card));
        updateProjectCount();
      }

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const group = button.getAttribute("data-filter-group");
          const key = button.getAttribute("data-filter-key") ?? "all";
          if (group === "field") fieldFilter = key;
          if (group === "context") contextFilter = key;
          filterButtons.forEach((item) => {
            if (item.getAttribute("data-filter-group") !== group) return;
            const active = item.getAttribute("data-filter-key") === key;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-pressed", String(active));
          });
          renderProjects();
        });
      });
      sortSelect?.addEventListener("change", renderProjects);
      viewButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const view = button.getAttribute("data-project-view") ?? "cards";
          projectArchive?.classList.toggle("is-list", view === "list");
          viewButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-pressed", String(active));
          });
        });
      });
      renderProjects();

      const menuButton = document.querySelector("[data-menu-button]");
      const navLinks = document.querySelector("[data-nav-links]");
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(open));
        navLinks?.classList.toggle("is-open", open);
      });
      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuButton?.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("is-open");
        });
      });

      const progress = document.querySelector(".scroll-progress");
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const amount = scrollable > 0 ? window.scrollY / scrollable : 0;
        if (progress instanceof HTMLElement) progress.style.transform = "scaleX(" + amount + ")";
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    </script>
